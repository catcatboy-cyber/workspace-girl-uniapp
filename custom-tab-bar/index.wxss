.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFDF5;
  border-top: 3rpx solid #111;
  box-shadow: 0 -4rpx 0 #111;
  display: flex;
  align-items: center;
  z-index: 10;
}
.tab-bar.is-hidden {
  display: none;
}
.tab-inner {
  flex: 1;
  display: flex;
  height: 100%;
}
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-item:nth-child(2) { margin-right: 50rpx; }
.tab-item:nth-child(3) { margin-left: 50rpx; }
.tab-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #999;
  line-height: 1.2;
}
.tab-item.active .tab-text {
  color: #111;
  font-weight: 800;
}

.crush-btn-wrap {
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  transform: translateX(-50%);
  z-index: 2;
}
.crush-btn {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #111;
  border: 3rpx solid #111;
  box-shadow: 0 6rpx 0 #FFD93D;
  display: flex;
  align-items: center;
  justify-content: center;
}
.crush-btn.active {
  background: #FFD93D;
  box-shadow: 0 6rpx 0 #111;
  transform: translateY(-4rpx);
}
.crush-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFD93D;
  line-height: 1.1;
}
.crush-btn.active .crush-text {
  color: #111;
}
.tab-bar.theme-velvet-diary {
  background: #FFF7EE;
  border-top-color: #D9B99D;
  box-shadow: 0 -4rpx 0 #D9B99D;
}
.tab-bar.theme-velvet-diary .tab-text {
  color: #B99A86;
}
.tab-bar.theme-velvet-diary .tab-item.active .tab-text {
  color: #5C3020;
}
.tab-bar.theme-velvet-diary .crush-btn {
  background: #5C3020;
  border-color: #D9B99D;
  box-shadow: 0 6rpx 0 #F0B869;
}
.tab-bar.theme-velvet-diary .crush-btn.active {
  background: #F0B869;
  box-shadow: 0 6rpx 0 #D9B99D;
}
.tab-bar.theme-velvet-diary .crush-text {
  color: #FFF0DC;
}
.tab-bar.theme-velvet-diary .crush-btn.active .crush-text {
  color: #5C3020;
}
.tab-bar.theme-rose-letter {
  background: #F7F4FA;
  border-top-color: #C7BEDA;
  box-shadow: 0 -4rpx 0 #C7BEDA;
}
.tab-bar.theme-rose-letter .tab-text {
  color: #948CA5;
}
.tab-bar.theme-rose-letter .tab-item.active .tab-text {
  color: #332E46;
}
.tab-bar.theme-rose-letter .crush-btn {
  background: #332E46;
  border-color: #C7BEDA;
  box-shadow: 0 6rpx 0 #C9BDE5;
}
.tab-bar.theme-rose-letter .crush-btn.active {
  background: #C9BDE5;
  box-shadow: 0 6rpx 0 #C7BEDA;
}
.tab-bar.theme-rose-letter .crush-text {
  color: #F0ECFA;
}
.tab-bar.theme-rose-letter .crush-btn.active .crush-text {
  color: #332E46;
}
.tab-bar.theme-seafoam-note {
  background: #F4FAF8;
  border-top-color: #BFD4D2;
  box-shadow: 0 -4rpx 0 #BFD4D2;
}
.tab-bar.theme-seafoam-note .tab-text {
  color: #8FA4A8;
}
.tab-bar.theme-seafoam-note .tab-item.active .tab-text {
  color: #24383D;
}
.tab-bar.theme-seafoam-note .crush-btn {
  background: #24383D;
  border-color: #BFD4D2;
  box-shadow: 0 6rpx 0 #6BB6AE;
}
.tab-bar.theme-seafoam-note .crush-btn.active {
  background: #6BB6AE;
  box-shadow: 0 6rpx 0 #BFD4D2;
}
.tab-bar.theme-seafoam-note .crush-text {
  color: #EEF8F5;
}
.tab-bar.theme-seafoam-note .crush-btn.active .crush-text {
  color: #24383D;
}
.tab-bar.font-large .tab-text,
.tab-bar.font-large .crush-text {
  font-size: 29rpx;
}
