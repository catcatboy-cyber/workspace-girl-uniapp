    {
      "id": "CQ01",
      "textSelf": "你和喜欢的人聊天时，通常是谁先开始？",
      "textTarget": "你们的聊天通常是谁先开始？",
      "options": [
        {
          "key": "A",
          "textSelf": "大多数时候都是我主动找对方。",
          "textTarget": "大多数时候都是 TA 主动找我。",
          "scores": {
            "initiative": 100
          }
        },
        {
          "key": "B",
          "textSelf": "我主动稍多，但对方也会主动。",
          "textTarget": "TA 主动稍多，但我也会主动。",
          "scores": {
            "initiative": 75
          }
        },
        {
          "key": "C",
          "textSelf": "基本五五开。",
          "textTarget": "基本五五开。",
          "scores": {
            "initiative": 50
          }
        },
        {
